# NOTE: Values used in production can be viewed/set in the secondary Linode server's fedsbot/.env file!

# Discord Bot Configuration
# (Get this from https://discord.com/developers/applications/1469560671971840020) 
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Anthropic API Key
# (Get from https://platform.claude.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Secret for calls to this server made by GitHub whenever code is updated
# (Used to protect the webhook/github API from being used by randos that discover it)
# (If changed, also update value at: https://github.com/feds201/feds-central/settings/hooks/595491205)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# API Key for calls to this server made by web chat clients (POST /api/chat)
# (Used to protect the chat API from being used by randos that discover it)
# (If changed, also update it in any web chat client that uses it)
API_KEY=your_api_key_here

# fedsbot/ Express server port
# (If changed, also update https://github.com/feds201/feds-central/settings/hooks/595491205 and any web chat client)
PORT=3333

# Experiment overrides, used by the evals (see README "Evals"). Leave unset in production.
# FEDSBOT_MODEL=opus                      # model alias or id (default: sonnet)
# FEDSBOT_EFFORT=low                      # low | medium | high | xhigh | max (default: model default)
# FEDSBOT_PROMPT_DIR=/path/to/prompts     # folder with system-prompt-{general,discord,chat}.md
