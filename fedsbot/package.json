{
  "name": "fedsbot",
  "version": "1.0.0",
  "description": "AI assistant Discord bot for The FEDS (FRC Team 201)",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "eval": "tsx evals/src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p evals"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "~0.3.322",
    "discord.js": "~14.28.1",
    "dotenv": "~18.0.10",
    "express": "~5.3.0"
  },
  "devDependencies": {
    "@types/express": "~5.0.6",
    "@types/node": "~22.20.5",
    "tsx": "~4.23.15",
    "typescript": "~7.0.2",
    "vitest": "~5.1.0"
  }
}
